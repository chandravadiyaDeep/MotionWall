<?xml version="1.0" encoding="utf-8"?>
<!-- Original MotionWall V0.3 thumbnail artwork: emerald. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#7DF0B2" android:centerColor="#147D75" android:endColor="#071F26" android:type="linear" />
        </shape>
    </item>
    <item android:width="190dp" android:height="190dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#99C9FFE5" />
        </shape>
    </item>
    <item android:width="112dp" android:height="112dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
            <stroke android:width="1dp" android:color="#77FFFFFF" />
        </shape>
    </item>
</layer-list>
