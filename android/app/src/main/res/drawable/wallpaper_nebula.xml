<?xml version="1.0" encoding="utf-8"?>
<!-- Original MotionWall V0.3 thumbnail artwork: nebula. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#FF8BCB" android:centerColor="#7048C8" android:endColor="#17112E" android:type="linear" />
        </shape>
    </item>
    <item android:width="190dp" android:height="190dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#88FFFFFF" />
        </shape>
    </item>
    <item android:width="112dp" android:height="112dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
            <stroke android:width="1dp" android:color="#77FFFFFF" />
        </shape>
    </item>
</layer-list>
