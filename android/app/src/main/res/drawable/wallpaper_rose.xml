<?xml version="1.0" encoding="utf-8"?>
<!-- Original MotionWall V0.3 thumbnail artwork: rose. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="135" android:startColor="#FF78B7" android:centerColor="#B32F91" android:endColor="#220D2D" android:type="linear" />
        </shape>
    </item>
    <item android:width="190dp" android:height="190dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#00FFFFFF" />
            <stroke android:width="2dp" android:color="#99FFD5F0" />
        </shape>
    </item>
    <item android:width="112dp" android:height="112dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#18FFFFFF" />
            <stroke android:width="1dp" android:color="#77FFFFFF" />
        </shape>
    </item>
</layer-list>
